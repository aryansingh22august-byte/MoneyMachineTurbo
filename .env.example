# ─────────────────────────────────────────────────────────────
# MoneyMachineTurbo — Environment Variables
# Copy to .env and fill in values for local dev.
# For Railway/Render/Fly.io: set these in each service's Variables tab.
# ─────────────────────────────────────────────────────────────

# ── Node.js App Service ───────────────────────────────────────
NODE_ENV=production
PORT=3000
REALTIME_PORT=8080

# PostgreSQL connection string (REQUIRED in production).
# The app connects with postgres-js (server/db.ts) and the Drizzle schema
# uses pgTable, so this MUST be a postgres:// URL.
#   Local:   postgres://postgres:password@localhost:5432/money_machine
#   Railway: use the Postgres plugin's generated DATABASE_URL
#   Render:  use the PostgreSQL addon's connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/money_machine

# HS256 signing key for OAuth session JWTs. Minimum 32 chars in production.
# Generate with: openssl rand -hex 32
# NOTE: the code reads JWT_SECRET. COOKIE_SECRET is accepted as an alias.
JWT_SECRET=replace_with_32_char_random_string

# ── Site-wide access gate ─────────────────────────────────────
# Shared password gating the UI shell, separate from OAuth login.
# In production the server REFUSES TO START if these are missing — they
# previously fell back to values hardcoded in the source, so anyone reading
# the repository could sign a valid session.
ACCESS_PASSWORD=replace_with_a_strong_password
# Signing key for the access-gate cookie. Falls back to JWT_SECRET if unset.
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_32_char_random_string

# URL of the Python ML service (internal DNS in production):
#   ML_API_URL=http://ml-service:5000   (Docker Compose)
#   ML_API_URL=http://<ml-service-private-domain>:5000   (Railway)
# For local dev (run ml_api.py separately):
ML_API_URL=http://localhost:5000

# Optional: Upstox live market feed (requires approved broker account)
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=https://<your-domain>/api/upstox/callback

# Optional: LLM-based news sentiment (Groq API)
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-8b

# Optional: set to MOCK only for local dev to bypass auth
# AUTH_MODE=MOCK

# ── Python ML Service ─────────────────────────────────────────
# MODEL_DIR=/app/models   (set in Railway/Render — volume mount: /app/models)
#
# Kronos foundation model. Defaults to false. When true the service downloads
# two models at startup (several minutes) and runs transformer inference on
# every /predict call — on CPU that is significant per-symbol latency across a
# ~120-stock sync cycle. Its forecast is blended with the per-symbol CNN-LSTM
# as a second opinion; it does not replace it.
# KRONOS_ENABLED=false